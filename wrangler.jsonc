// Cloudflare Workers settings for the Site Protocol app.
{
  "name": "site-protocols",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    // Everything in /public (the app itself) is served as normal files.
    "directory": "./public",
    "binding": "ASSETS",
    // Only /api/... requests go to src/index.js (used later for Smartsheet).
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare's built-in AI, used by "Improve text with AI". No key needed.
  "ai": {
    "binding": "AI"
  }
}
